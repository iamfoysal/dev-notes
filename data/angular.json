{
  "id": "angular",
  "slug": "angular",
  "title": "Angular",
  "logo": "https://angular.io/assets/images/logos/angular/angular.svg",
  "contents": [
      {
          "id": 1,
          "title": "Installation",
          "items": [
              {
                  "definition": "Install Angular CLI",
                  "code": "npm install -g @angular/cli"
              },
              {
                  "definition": "Create a new Angular project",
                  "code": "ng new project-name"
              }
          ]
      },
      {
          "id": 2,
          "title": "Development Server",
          "items": [
              {
                  "definition": "Serve the Angular application",
                  "code": "ng serve"
              },
              {
                  "definition": "Serve the Angular application and open in browser",
                  "code": "ng serve -o"
              }
          ]
      },
      {
          "id": 3,
          "title": "Components",
          "items": [
              {
                  "definition": "Create a new component",
                  "code": "ng generate component component-name"
              },
              {
                  "definition": "Create a component with inline styles and templates",
                  "code": "ng generate component component-name --inline-style --inline-template"
              }
          ]
      },
      {
          "id": 4,
          "title": "Services",
          "items": [
              {
                  "definition": "Create a new service",
                  "code": "ng generate service service-name"
              }
          ]
      },
      {
          "id": 5,
          "title": "Modules",
          "items": [
              {
                  "definition": "Create a new module",
                  "code": "ng generate module module-name"
              }
          ]
      },
      {
          "id": 6,
          "title": "Directives",
          "items": [
              {
                  "definition": "Create a new directive",
                  "code": "ng generate directive directive-name"
              }
          ]
      },
      {
          "id": 7,
          "title": "Pipes",
          "items": [
              {
                  "definition": "Create a new pipe",
                  "code": "ng generate pipe pipe-name"
              }
          ]
      },
      {
          "id": 8,
          "title": "Routing",
          "items": [
              {
                  "definition": "Create a new route module",
                  "code": "ng generate module app-routing --flat --module=app"
              },
              {
                  "definition": "Define a route with a component",
                  "code": "const routes: Routes = [{ path: 'home', component: HomeComponent }];"
              },
              {
                  "definition": "Define a route with lazy loading",
                  "code": "const routes: Routes = [{ path: 'about', loadChildren: () => import('./about/about.module').then(m => m.AboutModule) }];"
              },
              {
                  "definition": "Navigate to a route programmatically",
                  "code": "this.router.navigate(['/home']);"
              }
          ]
      },
      {
          "id": 9,
          "title": "Services & Dependency Injection",
          "items": [
              {
                  "definition": "Inject a service into a component",
                  "code": "constructor(private service: ServiceName) {}"
              }
          ]
      },
      {
          "id": 10,
          "title": "Forms",
          "items": [
              {
                  "definition": "Create a reactive form",
                  "code": "this.form = this.fb.group({ name: ['', Validators.required] });"
              },
              {
                  "definition": "Create a template-driven form",
                  "code": "<form #f='ngForm'><input ngModel name='name' required></form>"
              }
          ]
      },
      {
          "id": 11,
          "title": "Http Client",
          "items": [
              {
                  "definition": "Make an HTTP GET request",
                  "code": "this.http.get('https://api.example.com').subscribe(data => console.log(data));"
              },
              {
                  "definition": "Make an HTTP POST request",
                  "code": "this.http.post('https://api.example.com', data).subscribe(response => console.log(response));"
              }
          ]
      },
      {
          "id": 12,
          "title": "Testing",
          "items": [
              {
                  "definition": "Run unit tests",
                  "code": "ng test"
              },
              {
                  "definition": "Create a new test for a component",
                  "code": "ng generate component component-name --spec"
              }
          ]
      },
      {
          "id": 13,
          "title": "Build & Deployment",
          "items": [
              {
                  "definition": "Build the Angular project for production",
                  "code": "ng build --prod"
              },
              {
                  "definition": "Serve the Angular project for production",
                  "code": "ng serve --prod"
              }
          ]
      },
      {
          "id": 14,
          "title": "RxJS",
          "items": [
              {
                  "definition": "Import RxJS operators",
                  "code": "import { map, catchError } from 'rxjs/operators';"
              },
              {
                  "definition": "Create an observable",
                  "code": "const observable = new Observable(observer => { observer.next('Hello'); observer.complete(); });"
              },
              {
                  "definition": "Subscribe to an observable",
                  "code": "observable.subscribe(data => console.log(data));"
              },
              {
                  "definition": "Use the 'map' operator",
                  "code": "observable.pipe(map(data => data.toUpperCase())).subscribe(data => console.log(data));"
              },
              {
                  "definition": "Handle errors with 'catchError'",
                  "code": "observable.pipe(catchError(error => of('Error occurred!'))).subscribe(data => console.log(data));"
              },
              {
                  "definition": "Use 'mergeMap' for flattening observables",
                  "code": "observable.pipe(mergeMap(data => anotherObservable)).subscribe(data => console.log(data));"
              },
              {
                  "definition": "Combine multiple observables with 'combineLatest'",
                  "code": "combineLatest([observable1, observable2]).subscribe(([data1, data2]) => { console.log(data1, data2); });"
              },
              {
                  "definition": "Create a Subject",
                  "code": "const subject = new Subject();"
              },
              {
                  "definition": "Emit values using Subject",
                  "code": "subject.next('Hello');"
              },
              {
                  "definition": "Use 'BehaviorSubject' for state management",
                  "code": "const behaviorSubject = new BehaviorSubject('Initial State');"
              }
          ]
      },
      {
          "id": 15,
          "title": "NgRx",
          "items": [
              {
                  "definition": "Install NgRx Store",
                  "code": "ng add @ngrx/store"
              },
              {
                  "definition": "Create a state for a feature",
                  "code": "ng generate store feature --module app.module.ts"
              },
              {
                  "definition": "Create a reducer",
                  "code": "ng generate reducer feature"
              },
              {
                  "definition": "Create actions",
                  "code": "ng generate action feature/feature-action"
              },
              {
                  "definition": "Create effects",
                  "code": "ng generate effect feature/feature-effect"
              },
              {
                  "definition": "Dispatch an action",
                  "code": "this.store.dispatch(actionName());"
              },
              {
                  "definition": "Select a state from the store",
                  "code": "this.store.select(state => state.feature).subscribe(data => console.log(data));"
              },
              {
                  "definition": "Inject Store in a component",
                  "code": "constructor(private store: Store<AppState>) {}"
              },
              {
                  "definition": "Use a selector to get data",
                  "code": "const featureState = this.store.select(selectFeature);"
              }
          ]
      }
  ]
}
